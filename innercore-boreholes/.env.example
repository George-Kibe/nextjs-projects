# MongoDB Atlas connection string (include the database name, e.g. .../boreholes?retryWrites=true)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/boreholes?retryWrites=true&w=majority

# Password required to create, edit and delete boreholes
ADMIN_PASSWORD=change-me

# Long random string used to sign the login cookie (e.g. `openssl rand -hex 32`)
AUTH_SECRET=replace-with-a-long-random-string
